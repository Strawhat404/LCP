---
import PlatformBanner from "./PlatformBanner.astro";

interface Props {
  showBanner?: boolean;
}

const { showBanner = true } = Astro.props;

const email = "info@mylifecareplanning.com";

const allStates = [
  "alabama","alaska","arizona","arkansas","california","colorado","connecticut","delaware",
  "florida","georgia","hawaii","idaho","illinois","indiana","iowa","kansas","kentucky",
  "louisiana","maine","maryland","massachusetts","michigan","minnesota","mississippi",
  "missouri","montana","nebraska","nevada","new-hampshire","new-jersey","new-mexico",
  "new-york","north-carolina","north-dakota","ohio","oklahoma","oregon","pennsylvania",
  "rhode-island","south-carolina","south-dakota","tennessee","texas","utah","vermont",
  "virginia","washington","west-virginia","wisconsin","wyoming",
  // Canadian provinces (keeping as-is per client instruction)
  "alberta","british-columbia","manitoba","new-brunswick","newfoundland-and-labrador",
  "nova-scotia","ontario","quebec","saskatchewan"
];
---

{showBanner && (
  <div class="banner-outer">
    <div class="page-container">
      <PlatformBanner />
    </div>
  </div>
)}

<footer class="bg-gray-900 text-gray-300 mt-auto">
  <div class="page-container py-12">

    <!-- 4-column main footer -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">

      <!-- Column 1: About -->
      <div>
        <h3 class="text-white font-semibold text-base mb-3">Physician Life Care Planner Directory</h3>
        <p class="text-sm text-gray-400 leading-relaxed mb-3">
          A nationwide directory of physician life care planners. Search by state and metro to find board-certified MDs and DOs who prepare life care plans for injury and disability cases.
        </p>
        <p class="text-xs text-gray-500">Operated by MyLifeCarePlanning.com, Florida</p>
      </div>

      <!-- Column 2: Contact -->
      <div>
        <h3 class="text-white font-semibold text-base mb-3">Contact</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href={`mailto:${email}`} class="hover:text-white transition-colors">{email}</a>
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Monday–Friday, 9am–6pm ET</span>
          </li>
          <li>
            <a href="/contact" class="hover:text-white transition-colors text-sm">Contact us →</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Learn -->
      <div>
        <h3 class="text-white font-semibold text-base mb-3">Learn</h3>
        <ul class="space-y-1.5 text-sm">
          <li><a href="/what-is-a-physician-life-care-plan" class="hover:text-white transition-colors">What is a physician life care plan?</a></li>
          <li><a href="/what-is-a-physician-life-care-planner" class="hover:text-white transition-colors">What is a physician life care planner?</a></li>
          <li><a href="/physician-vs-nurse-life-care-planner" class="hover:text-white transition-colors">Physician vs nurse life care planner</a></li>
          <li><a href="/how-much-does-a-life-care-plan-cost" class="hover:text-white transition-colors">How much does a life care plan cost?</a></li>
          <li><a href="/when-should-an-attorney-order-a-life-care-plan" class="hover:text-white transition-colors">When to order a life care plan</a></li>
          <li><a href="/what-is-life-care-planning" class="hover:text-white transition-colors">What is life care planning?</a></li>
          <li><a href="/who-are-life-care-planners" class="hover:text-white transition-colors">Who are life care planners?</a></li>
        </ul>
      </div>

      <!-- Column 4: Directory -->
      <div>
        <h3 class="text-white font-semibold text-base mb-3">Directory</h3>
        <ul class="space-y-1.5 text-sm">
          <li><a href="/physician-life-care-planners" class="hover:text-white transition-colors">Browse all states</a></li>
          <li><a href="/physician-life-care-planners" class="hover:text-white transition-colors">All Life Care Planners</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact us</a></li>
        </ul>
      </div>
    </div>

    <!-- State block -->
    <div class="border-t border-gray-800 pt-8 mb-8">
      <h3 class="text-white text-sm font-semibold mb-4">Physician Life Care Planners by State</h3>
      <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-x-4 gap-y-1.5 text-xs">
        {allStates.map((state) => {
          const name = state.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
          return <li><a href={`/physician-life-care-planners/${state}`} class="hover:text-white transition-colors">{name}</a></li>;
        })}
      </ul>
    </div>

    <!-- Legal bar -->
    <div class="border-t border-gray-800 pt-6 mb-6">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500 justify-center md:justify-start">
        <li><a href="/privacy-policy" class="hover:text-gray-300 transition-colors">Privacy Policy</a></li>
        <li><a href="/terms-of-service" class="hover:text-gray-300 transition-colors">Terms of Service</a></li>
        <li><a href="/advertising-disclosure" class="hover:text-gray-300 transition-colors">Advertising Disclosure</a></li>
        <li><a href="/accessibility" class="hover:text-gray-300 transition-colors">Accessibility Statement</a></li>
        <li><a href="/do-not-sell" class="hover:text-gray-300 transition-colors">Do Not Sell or Share My Information</a></li>
        <li><a href="/data-removal" class="hover:text-gray-300 transition-colors">Data Corrections & Removal</a></li>
        <li><a href="/sitemap-index.xml" class="hover:text-gray-300 transition-colors">Sitemap</a></li>
      </ul>
    </div>

    <!-- Disclaimer -->
    <div class="border-t border-gray-800 pt-6 mb-6">
      <p class="text-xs text-gray-500 leading-relaxed max-w-4xl">
        This directory is an advertising and information service. It is not a referral service, a law firm, or a medical practice. Listings do not constitute an endorsement, and inclusion is not a recommendation. Nothing on this site is medical or legal advice. Verify all credentials directly with the certifying body and the applicable state licensing board before retaining any professional. Some listings are paid placements and are labeled "Sponsored."
      </p>
    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-800 pt-4 text-center text-xs text-gray-500">
      <p>&copy; 2026 mylifecareplanning.com. All rights reserved. Listing data last updated August 2026.</p>
    </div>

  </div>
</footer>

<style>
  .banner-outer {
    padding-top: 1rem;
    padding-bottom: 2rem;
  }
</style>
