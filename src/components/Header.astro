---
const phone = "800-292-1919";
const email = "info@life-care-planner-directory.com";
---

<header class="bg-brand-900 text-white">
  <div class="page-container">
    <div class="hidden md:flex items-center justify-end gap-6 text-xs py-1.5 border-b border-brand-800">
      <a href={`tel:${phone}`} class="hover:text-brand-200 transition-colors flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {phone}
      </a>
      <a href={`mailto:${email}`} class="hover:text-brand-200 transition-colors flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        {email}
      </a>
    </div>

    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5">
        <div class="w-9 h-9 bg-white rounded flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
          </svg>
        </div>
        <span class="text-xl font-bold tracking-tight">LCP Directory</span>
      </a>

      <nav class="hidden lg:flex items-center gap-1">
        <a href="/" class="px-3 py-2 text-sm font-medium rounded hover:bg-brand-800 transition-colors">Home</a>
        <a href="/what-is-life-care-planning" class="px-3 py-2 text-sm font-medium rounded hover:bg-brand-800 transition-colors">What is Life Care Planning</a>
        <a href="/who-are-life-care-planners" class="px-3 py-2 text-sm font-medium rounded hover:bg-brand-800 transition-colors">Who are Life Care Planners</a>

        <!-- Find LCPs Dropdown -->
        <div class="nav-dropdown">
          <button class="px-3 py-2 text-sm font-medium rounded hover:bg-brand-800 transition-colors flex items-center gap-1">
            Find LCPs
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="nav-dropdown-content">
            <a href="/locations" class="dropdown-item">Browse by State</a>
            <a href="/locations" class="dropdown-item">All Locations</a>
            <a href="/physician-life-care-planners" class="dropdown-item">Physician LCPs (MD/DO)</a>
          </div>
        </div>

        <a href="/contact" class="px-3 py-2 text-sm font-medium rounded hover:bg-brand-800 transition-colors">Contact</a>
        <a href={`tel:${phone}`} class="ml-3 btn-primary text-sm !py-2 !px-4 !bg-white !text-brand-900 hover:!bg-brand-100">
          Call {phone}
        </a>
      </nav>

      <button id="mobile-menu-btn" class="lg:hidden p-2 rounded text-white hover:bg-brand-800" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-brand-800">
    <div class="page-container py-4">
      <a href="/" class="block px-4 py-2 text-sm hover:bg-brand-700 rounded">Home</a>
      <a href="/what-is-life-care-planning" class="block px-4 py-2 text-sm hover:bg-brand-700 rounded">What is Life Care Planning</a>
      <a href="/who-are-life-care-planners" class="block px-4 py-2 text-sm hover:bg-brand-700 rounded">Who are Life Care Planners</a>

      <div class="mobile-dropdown">
        <button class="mobile-dropdown-btn w-full text-left px-4 py-2 text-sm hover:bg-brand-700 rounded flex items-center justify-between">
          Find LCPs
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="mobile-dropdown-content hidden pl-4">
          <a href="/locations" class="block px-4 py-2 text-sm hover:bg-brand-700 rounded">Browse by State</a>
          <a href="/locations" class="block px-4 py-2 text-sm hover:bg-brand-700 rounded">All Locations</a>
          <a href="/physician-life-care-planners" class="block px-4 py-2 text-sm hover:bg-brand-700 rounded">Physician LCPs (MD/DO)</a>
        </div>
      </div>

      <a href="/contact" class="block px-4 py-2 text-sm hover:bg-brand-700 rounded">Contact</a>
      <a href={`tel:${phone}`} class="block px-4 py-2 text-sm bg-white text-brand-900 hover:bg-brand-100 rounded mt-2 font-medium text-center">
        Call {phone}
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Mobile dropdown toggles
  document.querySelectorAll('.mobile-dropdown-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const dropdown = btn.nextElementSibling;
      const icon = btn.querySelector('svg');
      
      if (dropdown) {
        dropdown.classList.toggle('hidden');
        icon?.classList.toggle('rotate-180');
      }
    });
  });
</script>
