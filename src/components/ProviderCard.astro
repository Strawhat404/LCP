---
import type { Provider } from "../types/provider";
import { isPhysician } from "../utils/data";

interface Props {
  provider: Provider;
  showPhysicianBadge?: boolean;
}

const { provider, showPhysicianBadge = true } = Astro.props;
const physician = showPhysicianBadge && isPhysician(provider);

const stateName = provider.state.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const cityName = provider.city.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
---

<div class="card p-4 sm:p-5 flex flex-col sm:flex-row gap-4 group hover:border-brand-300">
  <a href={`/physician-life-care-planners/${provider.state}/${provider.city}/${provider.slug}`} class="flex-shrink-0">
    <div class="relative">
      <img
        src={provider.image}
        alt={provider.name}
        class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover bg-gray-200"
        width="80" height="80" loading="lazy"
      />
      {physician && (
        <span class="absolute -top-1 -right-1 bg-brand-700 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full leading-tight">MD</span>
      )}
    </div>
  </a>

  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <a
        href={`/physician-life-care-planners/${provider.state}/${provider.city}/${provider.slug}`}
        class="text-base font-semibold text-brand-800 hover:text-brand-600 transition-colors"
      >
        {provider.name}
      </a>
      {physician && (
        <span class="inline-flex items-center gap-1 bg-blue-50 text-blue-700 text-xs font-semibold px-2 py-0.5 rounded-full border border-blue-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Physician LCP
        </span>
      )}
    </div>
    <p class="text-xs text-brand-600 font-medium mt-0.5">{provider.specialty}</p>
    <p class="text-xs text-gray-500 mt-1">{cityName}, {stateName}</p>
    <p class="text-xs text-gray-600 mt-1.5 line-clamp-2">{provider.description}</p>
  </div>

  <div class="flex sm:flex-col justify-end gap-2 self-end sm:self-center flex-shrink-0">
    <a href={`tel:${provider.phone.replace(/[^\d+]/g, "")}`}
      class="text-xs font-medium text-brand-700 hover:text-brand-900 hover:underline flex items-center gap-1"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      Call
    </a>
    <a
      href={`/physician-life-care-planners/${provider.state}/${provider.city}/${provider.slug}`}
      class="text-xs font-medium text-gray-600 hover:text-brand-700 hover:underline"
    >
      View Profile
    </a>
  </div>
</div>
