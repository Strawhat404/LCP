---
interface StateInfo {
  slug: string;
  name: string;
  count: number;
}

interface Props {
  states: StateInfo[];
}

const { states } = Astro.props;

const stateDataMap = new Map(states.map(s => [s.slug, s]));

const stateCodeToSlug: Record<string, string> = {
  AL: 'alabama', AK: 'alaska', AZ: 'arizona', AR: 'arkansas',
  CA: 'california', CO: 'colorado', CT: 'connecticut', DE: 'delaware',
  FL: 'florida', GA: 'georgia', HI: 'hawaii', ID: 'idaho',
  IL: 'illinois', IN: 'indiana', IA: 'iowa', KS: 'kansas',
  KY: 'kentucky', LA: 'louisiana', ME: 'maine', MD: 'maryland',
  MA: 'massachusetts', MI: 'michigan', MN: 'minnesota', MS: 'mississippi',
  MO: 'missouri', MT: 'montana', NE: 'nebraska', NV: 'nevada',
  NH: 'new-hampshire', NJ: 'new-jersey', NM: 'new-mexico', NY: 'new-york',
  NC: 'north-carolina', ND: 'north-dakota', OH: 'ohio', OK: 'oklahoma',
  OR: 'oregon', PA: 'pennsylvania', RI: 'rhode-island',
  SC: 'south-carolina', SD: 'south-dakota', TN: 'tennessee',
  TX: 'texas', UT: 'utah', VT: 'vermont', VA: 'virginia',
  WA: 'washington', WV: 'west-virginia', WI: 'wisconsin', WY: 'wyoming',
  DC: 'district-of-columbia',
};

// Label positions computed in frontmatter (no TypeScript generics in script blocks)
const labelPositions: Record<string, [number, number]> = {
  WA:[207,142], OR:[207,178], ID:[248,160], CA:[200,238], NV:[248,236],
  AZ:[245,305], UT:[286,222], MT:[300,145], WY:[308,196], CO:[308,244],
  NM:[308,294], ND:[382,138], SD:[382,183], NE:[382,224], KS:[382,256],
  OK:[384,294], TX:[385,360], MN:[448,140], IA:[449,183], MO:[450,230],
  AR:[450,285], LA:[450,322], WI:[490,145], IL:[493,210], IN:[522,210],
  MI:[532,132], OH:[553,192], KY:[538,265], TN:[527,285], MS:[492,330],
  AL:[520,332], GA:[553,326], FL:[558,385], SC:[596,296], NC:[600,268],
  VA:[600,240], WV:[594,218], MD:[634,218], DE:[654,208], NJ:[666,196],
  PA:[617,194], NY:[618,168], CT:[680,172], RI:[689,168], MA:[680,154],
  VT:[654,138], NH:[666,134], ME:[683,124],
  AK:[198,408], HI:[264,425],
};

// Build label data array for template use
const stateLabels = Object.entries(stateCodeToSlug)
  .filter(([code]) => labelPositions[code])
  .map(([code, slug]) => ({
    code,
    slug,
    x: labelPositions[code][0],
    y: labelPositions[code][1],
    hasData: stateDataMap.has(slug),
  }));

const hasProviders = (slug: string) => stateDataMap.has(slug);
const cls = (slug: string) =>
  `state-path${hasProviders(slug) ? ' has-providers' : ''}`;

// Pass plain data to client script
const stateDataForScript = Object.fromEntries(
  states.map(s => [s.slug, { name: s.name, count: s.count }])
);
---

