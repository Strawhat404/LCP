---
import { statePaths } from '../data/statePaths';

interface StateInfo {
  slug: string;
  name: string;
  count: number;
}

interface Props {
  states: StateInfo[];
}

const { states } = Astro.props;

const stateDataMap = new Map(states.map(s => [s.slug, s]));
const hasProviders = (slug: string) => stateDataMap.has(slug);

const stateCodeToSlug: Record<string, string> = Object.fromEntries(
  Object.entries(statePaths).map(([code, info]) => [code, (info as any).slug])
);

const stateDataForScript = Object.fromEntries(
  states.map(s => [s.slug, { name: s.name, count: s.count }])
);

// Build list of all state entries for the template
const stateEntries = Object.entries(statePaths).map(([code, info]: [string, any]) => ({
  code,
  slug: info.slug,
  d: info.d,
  cx: parseFloat(info.cx),
  cy: parseFloat(info.cy),
  hasData: hasProviders(info.slug),
}));
---

<div class="usa-map-wrapper w-full max-w-5xl mx-auto select-none" style="position:relative;">
  <svg
    id="usa-map"
    viewBox="0 0 960 600"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto"
    aria-label="Interactive USA map — click a state to browse Life Care Planners"
  >
    <style>
      .state-path {
        fill: #d1d5db;
        stroke: #ffffff;
        stroke-width: 0.8;
        cursor: default;
        transition: fill 0.15s;
      }
      .state-path.has-providers {
        fill: #bfdbfe;
        cursor: pointer;
      }
      .state-path.has-providers:hover {
        fill: #2563eb;
      }
      .state-label {
        pointer-events: none;
        font-size: 7px;
        font-family: system-ui, sans-serif;
        font-weight: 700;
        text-anchor: middle;
        dominant-baseline: middle;
      }
    </style>

    <!-- All 50 states + DC drawn with real geographic paths -->
    {stateEntries.map(({ code, slug, d, cx, cy, hasData }) => (
      <>
        <path
          id={code}
          d={d}
          class={`state-path${hasData ? ' has-providers' : ''}`}
        />
        <text
          x={cx}
          y={cy}
          class="state-label"
          fill={hasData ? '#1e40af' : '#9ca3af'}
        >
          {code}
        </text>
      </>
    ))}
  </svg>

  <div id="map-tooltip" style="position:absolute;pointer-events:none;background:rgba(15,23,42,0.88);color:#fff;padding:5px 10px;border-radius:6px;font-size:12px;white-space:nowrap;display:none;z-index:50;"></div>

  <p class="text-center text-sm text-gray-500 mt-3">
    <span class="inline-block w-3 h-3 rounded bg-blue-200 mr-1 align-middle"></span>
    Blue states have Life Care Planners — click to browse
  </p>
</div>

<script define:vars={{ stateCodeToSlug, stateData: stateDataForScript }}>
  var tooltip = document.getElementById('map-tooltip');
  var wrapper = document.querySelector('.usa-map-wrapper');

  document.querySelectorAll('.state-path').forEach(function(el) {
    el.addEventListener('click', function() {
      var slug = stateCodeToSlug[el.id];
      if (slug && stateData[slug]) {
        window.location.href = '/' + slug;
      }
    });

    el.addEventListener('mouseenter', function(e) {
      var slug = stateCodeToSlug[el.id];
      var info = stateData[slug];
      if (info && tooltip) {
        tooltip.textContent = info.name + ' — ' + info.count + (info.count !== 1 ? ' LCPs' : ' LCP');
        tooltip.style.display = 'block';
      }
    });

    el.addEventListener('mousemove', function(e) {
      if (!tooltip || !wrapper) return;
      var rect = wrapper.getBoundingClientRect();
      tooltip.style.left = (e.clientX - rect.left + 12) + 'px';
      tooltip.style.top = (e.clientY - rect.top - 32) + 'px';
    });

    el.addEventListener('mouseleave', function() {
      if (tooltip) tooltip.style.display = 'none';
    });
  });
</script>
