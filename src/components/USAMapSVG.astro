const hasProviders = (slug: string) => stateDataMap.has(slug);

const stateLabels = Object.entries(stateCodeToSlug)
  .filter(([code]) => labelPositions[code] && statePaths[code])
  .map(([code, slug]) => ({
    code, slug,
    x: labelPositions[code][0],
    y: labelPositions[code][1],
    hasData: hasProviders(slug),
  }));

const stateDataForScript = Object.fromEntries(
  states.map(s => [s.slug, { name: s.name, count: s.count }])
);
---

<div class="usa-map-wrapper w-full max-w-5xl mx-auto select-none">
  <svg
    id="usa-map"
    viewBox="40 90 760 400"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto"
    aria-label="Interactive USA map – click a state to browse Life Care Planners"
  >
    <style>
      .state-path {
        fill: #d1d5db;
        stroke: #fff;
        stroke-width: 1;
        cursor: default;
        transition: fill 0.15s;
      }
      .state-path.has-providers {
        fill: #bfdbfe;
        cursor: pointer;
      }
      .state-path.has-providers:hover {
        fill: #2563eb;
      }
    </style>

    {Object.entries(statePaths).map(([code, path]) => {
      const slug = stateCodeToSlug[code];
      const hasData = hasProviders(slug);
      return (
        <path
          id={code}
          d={path}
          class={`state-path${hasData ? ' has-providers' : ''}`}
        />
      );
    })}

    {stateLabels.map(({ code, x, y, hasData }) => (
      <text
        x={x}
        y={y}
        text-anchor="middle"
        dominant-baseline="middle"
        class="pointer-events-none"
        font-size="6.5"
        font-family="system-ui, sans-serif"
        font-weight="700"
        fill={hasData ? '#1e40af' : '#9ca3af'}
      >
        {code}
      </text>
    ))}
  </svg>

  <div id="map-tooltip"></div>

  <p class="text-center text-sm text-gray-500 mt-3">
    <span class="inline-block w-3 h-3 rounded bg-blue-200 mr-1 align-middle"></span>Blue states have Life Care Planners — click to browse
  </p>
</div>

<script define:vars={{ stateCodeToSlug, stateData: stateDataForScript }}>
  var tooltip = document.getElementById('map-tooltip');
  var wrapper = document.querySelector('.usa-map-wrapper');

  document.querySelectorAll('.state-path').forEach(function(el) {
    el.addEventListener('click', function() {
      var slug = stateCodeToSlug[el.id];
      if (slug && stateData[slug]) {
        window.location.href = '/' + slug;
      }
    });

    el.addEventListener('mouseenter', function(e) {
      var slug = stateCodeToSlug[el.id];
      var info = stateData[slug];
      if (info && tooltip) {
        tooltip.textContent = info.name + ' — ' + info.count + (info.count !== 1 ? ' LCPs' : ' LCP');
        tooltip.style.display = 'block';
      }
    });

    el.addEventListener('mousemove', function(e) {
      if (!tooltip || !wrapper) return;
      var rect = wrapper.getBoundingClientRect();
      tooltip.style.left = (e.clientX - rect.left + 12) + 'px';
      tooltip.style.top  = (e.clientY - rect.top  - 32) + 'px';
    });

    el.addEventListener('mouseleave', function() {
      if (tooltip) tooltip.style.display = 'none';
    });
  });
</script>

<style>
  .usa-map-wrapper { position: relative; }
  #map-tooltip {
    position: absolute;
    pointer-events: none;
    background: rgba(15,23,42,0.88);
    color: #fff;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 12px;
    white-space: nowrap;
    display: none;
    z-index: 50;
  }
</style>
