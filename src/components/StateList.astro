---
interface Props {
  states: { name: string; count: number }[];
  heading?: string;
}

const { states, heading = "Browse by State / Province" } = Astro.props;
---

<section class="w-full">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">{heading}</h2>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
    {states.map(({ name, count }) => {
      const displayName = name
        .split("-")
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" ");

      return (
        <a
          href={`/${name}`}
          class="card p-4 flex flex-col items-center text-center gap-2 hover:border-brand-300 transition-colors group"
        >
          <span class="text-brand-700 font-semibold group-hover:text-brand-900 transition-colors">
            {displayName}
          </span>
          <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">
            {count} provider{count !== 1 ? "s" : ""}
          </span>
        </a>
      );
    })}
  </div>
</section>
