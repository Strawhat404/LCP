---
interface Props {
  providers: Array<{
    slug: string;
    name: string;
    city: string;
    state: string;
    specialty: string;
    image: string;
  }>;
}

const { providers } = Astro.props;
if (!providers || providers.length === 0) return null;
---

<div class="bg-gradient-to-r from-brand-700 to-brand-900 text-white rounded-lg p-6 mb-8">
  <div class="flex items-center gap-2 mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
    <h3 class="text-lg font-semibold">Sponsored Life Care Planners</h3>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    {providers.slice(0, 3).map((p) => {
      const stateName = p.state.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
      const cityName = p.city.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
      return (
        <a
          href={`/${p.state}/${p.city}/${p.slug}`}
          class="flex items-center gap-3 bg-white/10 rounded p-3 hover:bg-white/20 transition-colors"
        >
          <img src={p.image} alt={p.name} class="w-10 h-10 rounded-full bg-white/20 flex-shrink-0" width="40" height="40" />
          <div class="min-w-0">
            <p class="font-medium text-sm truncate">{p.name}</p>
            <p class="text-xs text-brand-200 truncate">{cityName}, {stateName}</p>
          </div>
        </a>
      );
    })}
  </div>
</div>
