---
// Sponsored banner — Dr. Arkam Rehman, MD (CaseReview.Health)
---

<div class="sponsored-banner-wrap">
  <div class="sponsored-banner">
    <!-- Sponsored label inside banner -->
    <div class="sponsored-label-inline">
      <svg xmlns="http://www.w3.org/2000/svg" class="star-icon" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      SPONSORED
    </div>

    <!-- LEFT: Doctor photo -->
    <div class="photo-cell">
      <div class="photo-frame">
        <img src="/dr-rehman.png" alt="Dr. Arkam Rehman, MD" loading="lazy" width="150" height="150" />
      </div>
    </div>

    <!-- MIDDLE: Name, credentials, affiliations -->
    <div class="info-cell">
      <div class="doc-name">Dr. Arkam Rehman, MD</div>
      <div class="doc-cred">Double Board Certified Physician | Certified Life Care Planner (CLCP)</div>
      <div class="badge-row">
        <span class="badge">ABPMR Diplomat</span>
        <span class="badge">Pain Medicine</span>
        <span class="badge">Depositions &amp; Trials</span>
      </div>
      <div class="affil">
        Sunshine Spine &amp; Pain PA &nbsp;·&nbsp; HCA Orange Park &nbsp;·&nbsp; Baptist South<br/>
        Ascension Riverside &nbsp;·&nbsp; LECOM Medical College
      </div>
    </div>

    <!-- TAGLINE strip -->
    <div class="tagline-cell">
      <div class="tagline-item">Express Turnaround</div>
      <span class="tagline-divider">◆</span>
      <div class="tagline-item">All 50 States</div>
    </div>

    <!-- RIGHT: QR code -->
    <div class="qr-cell">
      <div class="qr-box">
        <img src="/case-intelligence-qr.png" alt="Case Intelligence Roadmap QR Code" loading="lazy" width="96" height="96" />
      </div>
      <div class="qr-label">Case Intelligence<br/>Roadmap</div>
      <div class="qr-sub">Scan to explore ↑</div>
    </div>

  </div>
</div>

<style>
  .sponsored-banner-wrap {
    margin-bottom: 2rem;
    font-family: Inter, system-ui, -apple-system, sans-serif;
  }

  /* Banner container */
  .sponsored-banner {
    position: relative;
    width: 100%;
    background: linear-gradient(120deg, #1e3a8a 0%, #1d4ed8 55%, #1e40af 100%);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 28px 40px;
    gap: 0;
    box-shadow: 0 4px 24px rgba(30, 58, 138, 0.35);
  }

  /* Sponsored label inline inside banner */
  .sponsored-label-inline {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #92400e;
    background: #fbbf24;
    border-radius: 6px;
    padding: 6px 12px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    z-index: 10;
  }

  .star-icon {
    width: 12px;
    height: 12px;
    color: #92400e;
  }

  /* LEFT — doctor photo */
  .photo-cell {
    flex-shrink: 0;
    padding-right: 36px;
  }

  .photo-frame {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.4);
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* MIDDLE — name, creds, affiliations */
  .info-cell {
    flex: 1;
    padding-right: 32px;
    min-width: 0;
  }

  .doc-name {
    font-size: 24px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.3px;
  }

  .doc-cred {
    font-size: 13px;
    font-weight: 600;
    color: #93c5fd;
    margin-top: 6px;
    line-height: 1.5;
  }

  .badge-row {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .badge {
    font-size: 11px;
    font-weight: 600;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 20px;
    padding: 4px 12px;
    white-space: nowrap;
  }

  .affil {
    margin-top: 12px;
    font-size: 12px;
    font-weight: 400;
    color: #bfdbfe;
    line-height: 1.7;
  }

  /* TAGLINE strip */
  .tagline-cell {
    flex-shrink: 0;
    width: 170px;
    text-align: center;
    padding: 0 28px;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    border-right: 1px solid rgba(255, 255, 255, 0.2);
  }

  .tagline-item {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.4;
    letter-spacing: -0.2px;
  }

  .tagline-divider {
    color: #93c5fd;
    font-size: 16px;
    display: block;
    margin: 5px 0;
  }

  /* RIGHT — QR block */
  .qr-cell {
    flex-shrink: 0;
    text-align: center;
    padding-left: 28px;
  }

  .qr-box {
    background: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 8px;
    padding: 6px;
    width: 96px;
    height: 96px;
    margin: 0 auto;
  }

  .qr-box img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .qr-label {
    margin-top: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #93c5fd;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .qr-sub {
    margin-top: 2px;
    font-size: 10px;
    color: #bfdbfe;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .sponsored-banner {
      flex-direction: column;
      padding: 24px 20px;
      gap: 20px;
      text-align: center;
    }

    .photo-cell { padding-right: 0; }

    .photo-frame {
      width: 110px;
      height: 110px;
      margin: 0 auto;
    }

    .info-cell { padding-right: 0; }

    .badge-row { justify-content: center; }

    .tagline-cell {
      width: 100%;
      border-left: none;
      border-right: none;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      padding: 16px 0;
    }

    .qr-cell { padding-left: 0; }
  }
</style>
