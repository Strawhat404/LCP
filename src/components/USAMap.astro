---
interface StateInfo {
  slug: string;
  name: string;
  count: number;
}

interface Props {
  states: StateInfo[];
}

const { states } = Astro.props;

const stateMap: Record<string, { row: number; col: number }> = {
  alabama: { row: 5, col: 8 }, alaska: { row: 7, col: 1 }, arizona: { row: 4, col: 4 },
  arkansas: { row: 5, col: 6 }, california: { row: 3, col: 3 }, colorado: { row: 4, col: 5 },
  connecticut: { row: 3, col: 11 }, delaware: { row: 4, col: 10 }, florida: { row: 6, col: 9 },
  georgia: { row: 5, col: 9 }, hawaii: { row: 7, col: 2 }, idaho: { row: 2, col: 4 },
  illinois: { row: 4, col: 7 }, indiana: { row: 4, col: 8 }, iowa: { row: 4, col: 6 },
  kansas: { row: 4, col: 6 }, kentucky: { row: 5, col: 8 }, louisiana: { row: 6, col: 6 },
  maine: { row: 1, col: 12 }, maryland: { row: 4, col: 10 }, massachusetts: { row: 2, col: 11 },
  michigan: { row: 3, col: 8 }, minnesota: { row: 3, col: 6 }, mississippi: { row: 5, col: 7 },
  missouri: { row: 5, col: 6 }, montana: { row: 2, col: 4 }, nebraska: { row: 4, col: 6 },
  nevada: { row: 3, col: 4 }, "new-hampshire": { row: 2, col: 11 }, "new-jersey": { row: 4, col: 10 },
  "new-mexico": { row: 5, col: 5 }, "new-york": { row: 3, col: 10 }, "north-carolina": { row: 5, col: 9 },
  "north-dakota": { row: 2, col: 5 }, ohio: { row: 4, col: 8 }, oklahoma: { row: 5, col: 6 },
  oregon: { row: 2, col: 3 }, pennsylvania: { row: 4, col: 9 }, "rhode-island": { row: 3, col: 11 },
  "south-carolina": { row: 5, col: 9 }, "south-dakota": { row: 3, col: 5 }, tennessee: { row: 5, col: 8 },
  texas: { row: 5, col: 5 }, utah: { row: 3, col: 4 }, vermont: { row: 2, col: 11 },
  virginia: { row: 4, col: 9 }, washington: { row: 1, col: 3 }, "west-virginia": { row: 5, col: 9 },
  wisconsin: { row: 3, col: 7 }, wyoming: { row: 3, col: 5 },
};
---

<div class="w-full overflow-x-auto">
  <div class="inline-block min-w-[700px] w-full">
    <div class="relative" style="padding-bottom: 60%;">
      <div class="absolute inset-0 grid gap-0.5" style="grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(7, 1fr);">
        {states.map((st) => {
          const pos = stateMap[st.slug];
          if (!pos) return null;
          const abbr = st.slug.split("-").map(w => w[0].toUpperCase()).join("").slice(0, 2);
          return (
            <a
              href={`/${st.slug}`}
              class="flex flex-col items-center justify-center rounded border border-brand-200 hover:bg-brand-700 hover:text-white hover:border-brand-700 transition-all duration-200 text-xs font-medium bg-gray-50 text-gray-700 p-1 overflow-hidden"
              style={`grid-row: ${pos.row}; grid-column: ${pos.col};`}
              title={`${st.name} (${st.count} LCP${st.count !== 1 ? 's' : ''})`}
            >
              <span class="text-[10px] sm:text-xs font-bold leading-tight">{abbr}</span>
              <span class="text-[8px] sm:text-[10px] text-gray-400 leading-tight" style=".group-hover:text-blue-200: not-possible-in-astro">{st.count}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</div>
