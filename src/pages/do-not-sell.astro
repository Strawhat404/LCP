---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="Do Not Sell or Share My Information — MyLifeCarePlanning.com" description="California residents may opt out of the sale or sharing of personal information under CCPA.">
  <Header />
  <main class="flex-1">
    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto prose prose-gray">
        <h1>Do Not Sell or Share My Personal Information</h1>
        <p class="text-gray-500 text-sm">Last updated: August 2026</p>
        <p>This page is provided for California residents under the California Consumer Privacy Act (CCPA) and California Privacy Rights Act (CPRA).</p>
        <h2>Your Rights</h2>
        <p>California residents have the right to opt out of the sale or sharing of their personal information to third parties for cross-context behavioral advertising purposes.</p>
        <h2>What We Collect</h2>
        <p>MyLifeCarePlanning.com is a static informational directory. We do not operate user accounts, require registration, or collect personal information beyond standard server logs and analytics data that may be processed by third-party services.</p>
        <h2>How to Opt Out</h2>
        <p>To submit a do-not-sell or do-not-share request, or to request deletion of any personal data we may hold, contact us at:</p>
        <p><strong>Email:</strong> info@mylifecareplanning.com<br/>
        <strong>Subject line:</strong> CCPA Privacy Request</p>
        <p>We will respond to verified requests within 45 days as required by law.</p>
        <h2>Additional Rights</h2>
        <p>California residents may also have the right to know what personal information we collect, request correction of inaccurate information, and request deletion. Contact us at the address above to exercise any of these rights.</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
