---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="Data Corrections & Removal — MyLifeCarePlanning.com" description="Request corrections to your listing or removal from the MyLifeCarePlanning.com directory.">
  <Header />
  <main class="flex-1">
    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto prose prose-gray">
        <h1>Data Corrections and Removal</h1>
        <p class="text-gray-500 text-sm">Last updated: August 2026</p>
        <p>If you are a listed professional and need to update, correct, or remove your listing from MyLifeCarePlanning.com, please contact us using the information below.</p>
        <h2>Correction Requests</h2>
        <p>If any information in your listing is inaccurate — including name, credentials, contact information, or specialty — email us with the correct details and we will update your listing within 10 business days.</p>
        <h2>Removal Requests</h2>
        <p>If you wish to be removed from the directory entirely, email us with your full name, state, and the reason for removal. Removal requests are processed within 10 business days.</p>
        <h2>Contact</h2>
        <p><strong>Email:</strong> info@mylifecareplanning.com<br/>
        <strong>Subject line:</strong> Listing Correction / Removal Request</p>
        <p>Please include your full name, state, and a description of the change or removal requested. We may verify your identity before processing the request.</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
