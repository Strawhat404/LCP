---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Data Corrections & Removal - MyLifeCarePlanning.com"
  description="Request data corrections or removal from MyLifeCarePlanning.com. Learn about our permanent suppression protocol and identity verification process."
>
  <Header />

  <main class="flex-1">
    <section class="bg-brand-900 text-white">
      <div class="page-container py-10">
        <h1 class="text-3xl font-bold">Data Corrections &amp; Removal</h1>
        <div class="flex flex-wrap items-center gap-3 mt-3">
          <span class="inline-flex items-center gap-1.5 bg-white/10 text-brand-200 text-xs font-medium px-3 py-1 rounded-full">Effective Date: August 1, 2026</span>
          <span class="inline-flex items-center gap-1.5 bg-white/10 text-brand-200 text-xs font-medium px-3 py-1 rounded-full">Version 1.1</span>
        </div>
      </div>
    </section>

    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto">
        <div class="space-y-10 text-sm text-gray-700 leading-relaxed">

          <!-- CTA box -->
          <div class="bg-brand-50 border border-brand-200 rounded-xl p-6">
            <h2 class="text-base font-bold text-brand-900 mb-2">Request a Correction or Removal</h2>
            <p class="text-brand-800 mb-4">To request a correction or removal of your listing, email us. Identity verification is required before any changes are processed.</p>
            <a
              href="mailto:info@mylifecareplanning.com?subject=Data Correction or Removal Request"
              class="inline-flex items-center gap-2 bg-brand-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-brand-800 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Email Your Request
            </a>
          </div>

          <section>
            <h2 class="text-base font-bold text-gray-900 mb-1 flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-brand-100 text-brand-700 text-xs font-bold flex items-center justify-center flex-shrink-0">1</span>
              Accuracy and Identity Verification
            </h2>
            <p class="pl-8">We prioritize the integrity of our records. To request a correction or removal, please email <a href="mailto:info@mylifecareplanning.com" class="text-brand-700 font-medium hover:underline">info@mylifecareplanning.com</a>. To prevent unauthorized modifications, we require <strong>identity verification</strong> before processing changes to any professional listing.</p>
          </section>

          <section>
            <h2 class="text-base font-bold text-gray-900 mb-1 flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-brand-100 text-brand-700 text-xs font-bold flex items-center justify-center flex-shrink-0">2</span>
              Permanent Suppression Protocol
            </h2>
            <p class="pl-8">To ensure that a requested removal is permanent, we maintain a <strong>Permanent Suppression List</strong>. When a professional listing is purged at the owner's request, its unique identifiers are logged in this list to ensure that future data re-imports do not inadvertently restore the deleted information.</p>
          </section>

          <section>
            <h2 class="text-base font-bold text-gray-900 mb-1 flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-brand-100 text-brand-700 text-xs font-bold flex items-center justify-center flex-shrink-0">3</span>
              Legal Hold Exceptions
            </h2>
            <p class="pl-8">If information is subject to a <strong>Legal Hold</strong> due to active litigation or a regulatory inquiry, our normal deletion protocols will be suspended to satisfy evidentiary preservation requirements until the hold is formally released.</p>
          </section>

          <div class="border-t border-gray-200 pt-6">
            <p class="text-xs text-gray-500">For correction or removal requests, contact <a href="mailto:info@mylifecareplanning.com" class="text-brand-700 hover:underline">info@mylifecareplanning.com</a>.</p>
          </div>

        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
