---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import SponsoredBanner from "../../../components/SponsoredBanner.astro";
import PlatformBanner from "../../../components/PlatformBanner.astro";
import { getAllStates, getCitiesByState, getProviderCountByCity, getPhysicianCountByCity } from "../../../utils/data";
export function getStaticPaths() {
  return getAllStates().map((state) => ({ params: { state } }));
}

const { state } = Astro.params;

const stateDisplay = state!
  .split("-")
  .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
  .join(" ");

const cities = getCitiesByState(state!).map((city) => ({
  name: city,
  count: getProviderCountByCity(state!, city),
  physicianCount: getPhysicianCountByCity(state!, city),
  displayName: city.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
}));
---

<BaseLayout
  title={`Life Care Planners in ${stateDisplay} - Find LCPs Near You`}
  description={`Find qualified Life Care Planners in ${stateDisplay}. Browse by major cities to locate professionals in your area.`}
>
  <Header />

  <main class="flex-1">
    <div class="page-container section-padding">
      <Breadcrumb
        links={[
          { label: "Home", href: "/" },
          { label: stateDisplay, href: `/physician-life-care-planners/${state}` },
        ]}
      />

      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Life Care Planners in {stateDisplay}
      </h1>
      <p class="text-gray-600 mb-6">
        Find qualified Life Care Planners in major metropolitan areas across {stateDisplay}.
      </p>

      <SponsoredBanner />

      <div class="mb-8">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Select a City</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          {cities.map(({ name, count, physicianCount, displayName }) => (
            <a
              href={`/physician-life-care-planners/${state}/${name}`}
              class="card p-4 hover:border-brand-400 transition-colors group flex items-center justify-between"
            >
              <span class="font-medium text-gray-800 group-hover:text-brand-700 transition-colors">{displayName}</span>
              <span class="text-xs bg-brand-50 text-brand-700 px-2 py-0.5 rounded-full font-medium">
                {count} LCP{count !== 1 ? "s" : ""}{physicianCount > 0 ? ` (${physicianCount} Physician)` : ""}
              </span>
            </a>
          ))}
        </div>
      </div>

      <PlatformBanner />

      <div class="mt-8 text-center">
        <a href="/physician-life-care-planners" class="inline-flex items-center gap-2 text-brand-700 font-medium hover:text-brand-900 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to All Locations
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
