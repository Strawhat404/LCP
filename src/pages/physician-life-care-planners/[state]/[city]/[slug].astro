---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import { getAllProviders, getProviderBySlug } from "../../../../utils/data";

export function getStaticPaths() {
  return getAllProviders().map((p) => ({
    params: { state: p.state, city: p.city, slug: p.slug },
  }));
}

const { state, city, slug } = Astro.params;
const provider = getProviderBySlug(slug!);

if (!provider) {
  return Astro.redirect("/404");
}

const stateDisplay = state!.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const cityDisplay = city!.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
---

<BaseLayout
  title={`${provider.name} - Life Care Planner in ${cityDisplay}, ${stateDisplay}`}
  description={provider.description}
>
  <Header />

  <main class="flex-1">
    <div class="page-container section-padding">
      <Breadcrumb
        links={[
          { label: "Home", href: "/" },
          { label: stateDisplay, href: `/physician-life-care-planners/${state}` },
          { label: cityDisplay, href: `/physician-life-care-planners/${state}/${city}` },
          { label: provider.name, href: `/physician-life-care-planners/${state}/${city}/${slug}` },
        ]}
      />

      <div class="card p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row gap-6 items-start">
          <img
            src={provider.image}
            alt={provider.name}
            class="w-28 h-28 sm:w-36 sm:h-36 rounded-full object-cover bg-gray-200 flex-shrink-0"
            width="144" height="144"
          />

          <div class="flex-1">
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">{provider.name}</h1>
            <p class="text-lg text-brand-700 font-medium mt-1">{provider.specialty}</p>
            <p class="text-sm text-gray-500 mt-1">{cityDisplay}, {stateDisplay}</p>

            <p class="mt-5 text-gray-700 leading-relaxed">{provider.description}</p>

            <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span class="text-gray-700 text-sm">{provider.address}</span>
              </div>

              <div class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <a href={`tel:${provider.phone.replace(/[^\d+]/g, "")}`} class="text-brand-700 hover:text-brand-900 hover:underline text-sm font-medium">
                  {provider.phone}
                </a>
              </div>

              <div class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <a href={`mailto:${provider.email}`} class="text-brand-700 hover:text-brand-900 hover:underline text-sm font-medium">
                  {provider.email}
                </a>
              </div>

            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-8">
        <a href={`/physician-life-care-planners/${state}/${city}`} class="text-brand-700 hover:text-brand-900 hover:underline text-sm font-medium">
          &larr; Back to {cityDisplay} Life Care Planners
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
