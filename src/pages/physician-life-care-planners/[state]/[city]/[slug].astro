---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import { getAllProviders, getProviderBySlug } from "../../../../utils/data";

export function getStaticPaths() {
  return getAllProviders().map((p) => ({
    params: { state: p.state, city: p.city, slug: p.slug },
  }));
}

const { state, city, slug } = Astro.params;
const provider = getProviderBySlug(slug!);

if (!provider) {
  return Astro.redirect("/404");
}

const stateDisplay = state!.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const cityDisplay = city!.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");

const profileSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Physician",
      "@id": `https://www.mylifecareplanning.com/physician-life-care-planners/${state}/${city}/${slug}/#physician`,
      "name": provider.name,
      "jobTitle": "Physician Life Care Planner",
      "medicalSpecialty": {
        "@type": "MedicalSpecialty",
        "name": "Physical Medicine and Rehabilitation"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": cityDisplay,
        "addressRegion": provider.stateCode,
        "addressCountry": provider.country === "Canada" ? "CA" : "US"
      },
      "knowsAbout": [
        "Life Care Planning",
        "Catastrophic Injury Valuation",
        "Physical Medicine and Rehabilitation",
        "Expert Witness Testimony"
      ],
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "credentialCategory": "Professional Certification",
          "name": provider.certification || "CLCP",
          "recognizedBy": {
            "@type": "Organization",
            "name": "Commission on Health Care Certification"
          }
        }
      ],
      "memberOf": {"@id": "https://www.mylifecareplanning.com/#organization"}
    },
    {
      "@type": "BreadcrumbList",
      "@id": `https://www.mylifecareplanning.com/physician-life-care-planners/${state}/${city}/${slug}/#breadcrumb`,
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.mylifecareplanning.com/"},
        {"@type": "ListItem", "position": 2, "name": "Physician Life Care Planners", "item": "https://www.mylifecareplanning.com/physician-life-care-planners/"},
        {"@type": "ListItem", "position": 3, "name": stateDisplay, "item": `https://www.mylifecareplanning.com/physician-life-care-planners/${state}/`},
        {"@type": "ListItem", "position": 4, "name": cityDisplay, "item": `https://www.mylifecareplanning.com/physician-life-care-planners/${state}/${city}/`},
        {"@type": "ListItem", "position": 5, "name": provider.name, "item": `https://www.mylifecareplanning.com/physician-life-care-planners/${state}/${city}/${slug}/`}
      ]
    }
  ]
});
---

<BaseLayout
  title={`${provider.name} - Life Care Planner in ${cityDisplay}, ${stateDisplay}`}
  description={`${provider.name} is a board-certified ${provider.specialty} Physician Life Care Planner in ${cityDisplay}, ${stateDisplay}. ${provider.certification}. Expert medical-legal future care cost valuations.`}
  canonical={`https://www.mylifecareplanning.com/physician-life-care-planners/${state}/${city}/${slug}/`}
  schema={profileSchema}
>
  <Header />

  <main class="flex-1">
    <div class="page-container section-padding">
      <Breadcrumb
        links={[
          { label: "Home", href: "/" },
          { label: stateDisplay, href: `/physician-life-care-planners/${state}` },
          { label: cityDisplay, href: `/physician-life-care-planners/${state}/${city}` },
          { label: provider.name, href: `/physician-life-care-planners/${state}/${city}/${slug}` },
        ]}
      />

      <div class="card p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row gap-6 items-start">
          <img
            src={`/avatars/${provider.slug}.svg`}
            alt={provider.name}
            class="w-28 h-28 sm:w-36 sm:h-36 rounded-full object-cover bg-gray-200 flex-shrink-0"
            width="144" height="144"
          />

          <div class="flex-1">
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">{provider.name}</h1>
            <p class="text-lg text-brand-700 font-medium mt-1">{provider.specialty}</p>
            <p class="text-sm text-gray-500 mt-1">{cityDisplay}, {stateDisplay}</p>

            <p class="mt-5 text-gray-700 leading-relaxed">{provider.description}</p>

            <!-- Claim listing CTA -->
            <div class="mt-8 p-5 bg-gray-50 border border-gray-200 rounded-xl">
              <h2 class="text-base font-semibold text-gray-900 mb-1">Is this your listing?</h2>
              <p class="text-sm text-gray-600 mb-4">
                If you are {provider.name}, you can claim this listing to update your information, add your contact details, and manage your profile.
              </p>
              <a
                href={`/contact?claim=${provider.slug}&name=${encodeURIComponent(provider.name)}`}
                class="inline-flex items-center gap-2 bg-brand-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-brand-800 transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                Claim This Listing
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-8">
        <a href={`/physician-life-care-planners/${state}/${city}`} class="text-brand-700 hover:text-brand-900 hover:underline text-sm font-medium">
          &larr; Back to {cityDisplay} Life Care Planners
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
