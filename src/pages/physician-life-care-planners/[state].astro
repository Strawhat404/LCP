---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProviderCard from "../../components/ProviderCard.astro";
import { getPhysiciansByState } from "../../utils/data";

// All states we want pages for — matches footer list plus Canadian provinces
const ALL_STATES = [
  "alabama","alaska","arizona","arkansas","california","colorado","connecticut","delaware",
  "florida","georgia","hawaii","idaho","illinois","indiana","iowa","kansas","kentucky",
  "louisiana","maine","maryland","massachusetts","michigan","minnesota","mississippi",
  "missouri","montana","nebraska","nevada","new-hampshire","new-jersey","new-mexico",
  "new-york","north-carolina","north-dakota","ohio","oklahoma","oregon","pennsylvania",
  "rhode-island","south-carolina","south-dakota","tennessee","texas","utah","vermont",
  "virginia","washington","west-virginia","wisconsin","wyoming",
  "alberta","british-columbia","manitoba","new-brunswick","newfoundland-and-labrador",
  "nova-scotia","ontario","quebec","saskatchewan"
];

export function getStaticPaths() {
  const ALL_STATES = [
    "alabama","alaska","arizona","arkansas","california","colorado","connecticut","delaware",
    "florida","georgia","hawaii","idaho","illinois","indiana","iowa","kansas","kentucky",
    "louisiana","maine","maryland","massachusetts","michigan","minnesota","mississippi",
    "missouri","montana","nebraska","nevada","new-hampshire","new-jersey","new-mexico",
    "new-york","north-carolina","north-dakota","ohio","oklahoma","oregon","pennsylvania",
    "rhode-island","south-carolina","south-dakota","tennessee","texas","utah","vermont",
    "virginia","washington","west-virginia","wisconsin","wyoming",
    "alberta","british-columbia","manitoba","new-brunswick","newfoundland-and-labrador",
    "nova-scotia","ontario","quebec","saskatchewan"
  ];
  return ALL_STATES.map(state => ({ params: { state } }));
}

const { state } = Astro.params;

const stateDisplay = state!.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const physicians = getPhysiciansByState(state!);

---

<BaseLayout
  title={`Physician Life Care Planners in ${stateDisplay} — MD & DO Expert Witnesses`}
  description={`Find board-certified physician Life Care Planners (MD, DO) in ${stateDisplay}. Trusted by attorneys and courts for expert witness testimony and life care plan documentation.`}
>
  <Header />

  <main class="flex-1">
    <div class="page-container section-padding">
      <Breadcrumb
        links={[
          { label: "Home", href: "/" },
          { label: "Physician LCPs", href: "/physician-life-care-planners" },
          { label: stateDisplay, href: `/physician-life-care-planners/${state}` },
        ]}
      />

      <div class="flex items-center gap-3 mb-2 flex-wrap">
        <h1 class="text-3xl font-bold text-gray-900">
          Physician Life Care Planners in {stateDisplay}
        </h1>
        <span class="bg-brand-100 text-brand-800 text-sm font-semibold px-3 py-1 rounded-full">
          {physicians.length} MD{physicians.length !== 1 ? 's' : ''}
        </span>
      </div>
      <p class="text-gray-600 mb-8">
        Board-certified MDs and DOs in {stateDisplay} who specialize in life care planning. Trusted by personal injury attorneys and courts.
      </p>

      <!-- Provider listings -->
      <div class="space-y-3 mb-10">
        {physicians.length > 0 ? (
          physicians.map(provider => (
            <ProviderCard provider={provider} />
          ))
        ) : (
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-8 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <h3 class="text-lg font-semibold text-gray-700 mb-2">No Physician LCPs Listed Yet in {stateDisplay}</h3>
            <p class="text-gray-500 text-sm max-w-md mx-auto mb-4">
              Our directory is updated regularly as new board-certified physician life care planners join. Check back soon or browse states with active listings.
            </p>
            <a href="/physician-life-care-planners" class="btn-primary text-sm">Browse All States</a>
          </div>
        )}
      </div>

      <!-- Enriched content block — always shown, especially valuable for thin pages -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
        <div class="bg-brand-50 border border-brand-100 rounded-xl p-6">
          <h2 class="text-lg font-bold text-brand-900 mb-3">Why Retain a Physician Life Care Planner in {stateDisplay}?</h2>
          <p class="text-sm text-gray-700 leading-relaxed mb-3">
            Attorneys handling catastrophic injury cases in {stateDisplay} increasingly retain physician life care planners — board-certified MDs or DOs — because their medical degree gives them independent authority to diagnose, interpret records, and defend every recommendation under cross-examination.
          </p>
          <p class="text-sm text-gray-700 leading-relaxed">
            A physician-authored life care plan carries greater weight in depositions, mediations, and trials than plans prepared by non-physician planners, particularly in high-value spinal cord injury, TBI, and multi-system trauma cases.
          </p>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
          <h2 class="text-lg font-bold text-gray-900 mb-3">Common Cases Requiring a Physician LCP</h2>
          <ul class="space-y-2 text-sm text-gray-700">
            {[
              "Traumatic brain injury (TBI)",
              "Spinal cord injury and paralysis",
              "Amputation and limb loss",
              "Severe burns and disfigurement",
              "Complex orthopedic injuries",
              "Medical malpractice with permanent disability",
              "Workers' compensation catastrophic claims",
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="mt-1 w-1.5 h-1.5 rounded-full bg-brand-500 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- What to ask section -->
      <div class="bg-brand-900 text-white rounded-xl p-6 mb-10">
        <h2 class="text-lg font-bold mb-4">Questions to Ask Before Retaining a Physician LCP</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {[
            "What is your medical specialty and board certification?",
            "How many life care plans have you prepared in the past year?",
            "Have you testified at deposition or trial as an expert witness?",
            "What is your methodology for future cost projections?",
            "Are you available for cases in {stateDisplay}?",
            "What is your turnaround time for a completed plan?",
          ].map(q => (
            <div class="flex items-start gap-2 text-sm text-brand-100">
              <span class="mt-1 text-brand-400 flex-shrink-0">→</span>
              {q.replace('{stateDisplay}', stateDisplay)}
            </div>
          ))}
        </div>
      </div>

      <div class="text-center">
        <a href="/physician-life-care-planners" class="inline-flex items-center gap-2 text-brand-700 font-medium hover:text-brand-900 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to All Physician LCPs
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
