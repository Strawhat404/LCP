---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="Terms of Service — MyLifeCarePlanning.com" description="Terms of service for MyLifeCarePlanning.com.">
  <Header />
  <main class="flex-1">
    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto prose prose-gray">
        <h1>Terms of Service</h1>
        <p class="text-gray-500 text-sm">Last updated: August 2026</p>
        <p>By accessing or using MyLifeCarePlanning.com, you agree to these Terms of Service. If you do not agree, please do not use this site.</p>
        <h2>Use of the Directory</h2>
        <p>This directory is provided for informational and advertising purposes only. It is not a referral service, legal service, or medical service. We make no representations regarding the accuracy, completeness, or reliability of any listing.</p>
        <h2>No Professional Advice</h2>
        <p>Nothing on this site constitutes medical, legal, or professional advice. Always verify credentials directly with the certifying body and applicable state licensing board before retaining any professional.</p>
        <h2>Listing Accuracy</h2>
        <p>We strive to maintain accurate listing information but cannot guarantee that all information is current. Professionals are responsible for updating their information. For corrections, contact us at info@mylifecareplanning.com.</p>
        <h2>Paid Listings</h2>
        <p>Some listings on this site are paid placements and are labeled "Sponsored." Paid placement does not constitute an endorsement.</p>
        <h2>Changes</h2>
        <p>We reserve the right to update these terms at any time. Continued use of the site constitutes acceptance of updated terms.</p>
        <h2>Contact</h2>
        <p>Questions about these terms? Email info@mylifecareplanning.com.</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
