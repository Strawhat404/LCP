---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import USAMapSVG from "../components/USAMapSVG.astro";
import LocationMap from "../components/LocationMap.astro";
import { getAllStates, getProviderCountByState } from "../utils/data";

const states = getAllStates().map((state) => ({
  slug: state,
  name: state.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
  count: getProviderCountByState(state),
}));

const phone = "800-292-1919";
---

<BaseLayout
  title="Life Care Planner Directory - Find LCPs Across the USA"
  description="Find qualified Life Care Planners across the United States. Browse by state to locate professionals in your area."
>
  <Header />

  <main class="flex-1">
    <!-- Hero with background image -->
    <section class="relative bg-brand-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="https://images.unsplash.com/photo-1584982751601-97dcc096659c?w=1200&q=60&auto=format&fit=crop"
          alt="Medical professional reviewing documents"
          class="w-full h-full object-cover opacity-20"
          fetchpriority="high"
          loading="eager"
          width="1200"
          height="800"
        />
      </div>
      <div class="relative page-container section-padding text-center">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight">
          Find Life Care Planners Near You
        </h1>
        <p class="mt-4 text-lg text-brand-200 max-w-2xl mx-auto">
          Connect with qualified Life Care Planners across the United States.
          Browse by state to locate a professional in your area.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/life-care-planners" class="btn-primary !bg-white !text-brand-900 hover:!bg-brand-100">Browse by State</a>
          <a href="/what-is-life-care-planning" class="btn-primary !bg-transparent !border-2 !border-white hover:!bg-white/10">What is Life Care Planning?</a>
        </div>
      </div>
    </section>

    <!-- Info cards: What is LCP / Who needs one -->
    <section class="page-container section-padding">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-brand-50 border border-brand-100 rounded-xl overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=600&q=60&auto=format&fit=crop"
            alt="Doctor reviewing medical documents"
            class="w-full aspect-video object-cover"
            loading="lazy"
            width="600"
            height="338"
          />
          <div class="p-6">
            <h2 class="text-xl font-bold text-brand-900 mb-3">What is a Life Care Planner?</h2>
            <p class="text-gray-700 leading-relaxed mb-3">
              A Life Care Planner (LCP) is a specialized healthcare professional who develops comprehensive,
              evidence-based plans that detail the future medical, therapeutic, and supportive needs of individuals
              with catastrophic injuries or chronic health conditions.
            </p>
            <p class="text-gray-700 leading-relaxed">
              These plans are used in legal proceedings, insurance settlements, and long-term care coordination
              to ensure injured or ill individuals receive appropriate and adequate care throughout their lifetime.
            </p>
            <a href="/what-is-life-care-planning" class="inline-block mt-4 text-brand-700 font-medium hover:text-brand-900 transition-colors">
              Learn more →
            </a>
          </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
          <img
            src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=600&q=60&auto=format&fit=crop"
            alt="Legal professional and client in consultation"
            class="w-full aspect-video object-cover"
            loading="lazy"
            width="600"
            height="338"
          />
          <div class="p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-3">Who Needs a Life Care Planner?</h2>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start gap-2">
                <span class="mt-1 w-2 h-2 rounded-full bg-brand-500 flex-shrink-0"></span>
                <span><strong>Personal injury attorneys</strong> seeking expert witnesses and documented cost projections</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 w-2 h-2 rounded-full bg-brand-500 flex-shrink-0"></span>
                <span><strong>Insurance companies</strong> needing objective future care cost assessments for settlements</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 w-2 h-2 rounded-full bg-brand-500 flex-shrink-0"></span>
                <span><strong>Families and caregivers</strong> coordinating long-term care for loved ones with complex needs</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1 w-2 h-2 rounded-full bg-brand-500 flex-shrink-0"></span>
                <span><strong>Healthcare providers</strong> transitioning patients from acute care to community settings</span>
              </li>
            </ul>
            <a href="/who-are-life-care-planners" class="inline-block mt-4 text-brand-700 font-medium hover:text-brand-900 transition-colors">
              Meet our Life Care Planners →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Video section -->
    <section class="page-container section-padding">
      <div class="text-center mb-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Learn About Life Care Planning</h2>
        <p class="text-gray-600 max-w-xl mx-auto">Watch this short overview to understand what Life Care Planners do and why they matter.</p>
      </div>
      <div class="max-w-3xl mx-auto rounded-xl overflow-hidden shadow-md border border-gray-200 bg-gray-900 aspect-video flex flex-col items-center justify-center text-white">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-gray-500 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-gray-400 text-sm">Video coming soon</p>
      </div>
    </section>

    <!-- Maps section: Leaflet map first, then compact SVG below -->
    <section class="bg-gray-50">
      <div class="page-container section-padding">
        <div class="text-center mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Find Life Care Planners Near You</h2>
          <p class="text-gray-600 max-w-xl mx-auto">Hover over any pin to see provider count. Click to browse that state.</p>
        </div>

        <!-- Leaflet marker map — full width, prominent -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4 mb-6">
          <LocationMap />
        </div>


      </div>
    </section>

    <!-- Feature cards with images -->
    <section class="bg-white">
      <div class="page-container section-padding">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-bold text-gray-900">Why Use Our Directory?</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="card overflow-hidden">
            <img src="https://images.unsplash.com/photo-1516574187841-cb9cc2ca948b?w=400&q=60&auto=format&fit=crop" alt="Searching for a professional" class="w-full aspect-video object-cover" loading="lazy" width="400" height="225"/>
            <div class="p-5 text-center">
              <h3 class="font-semibold text-gray-900 mb-1">Browse by State</h3>
              <p class="text-sm text-gray-600">Find Life Care Planners organized by state and major metro cities across the USA and Canada.</p>
            </div>
          </div>

          <div class="card overflow-hidden">
            <img src="https://images.unsplash.com/photo-1551601651-2a8555f1a136?w=400&q=40&auto=format&fit=crop" alt="Certified medical professional" class="w-full aspect-video object-cover" loading="lazy" width="400" height="225"/>
            <div class="p-5 text-center">
              <h3 class="font-semibold text-gray-900 mb-1">Qualified Professionals</h3>
              <p class="text-sm text-gray-600">All listed Life Care Planners hold recognized certifications and come from verified rehabilitation backgrounds.</p>
            </div>
          </div>

          <div class="card overflow-hidden">
            <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=400&q=40&auto=format&fit=crop" alt="Professional consultation" class="w-full aspect-video object-cover" loading="lazy" width="400" height="225"/>
            <div class="p-5 text-center">
              <h3 class="font-semibold text-gray-900 mb-1">Contact Directly</h3>
              <p class="text-sm text-gray-600">Reach Life Care Planners directly through their listed contact information — no middleman.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
