---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getAllStates, getAllProviders } from "../utils/data";

const totalProviders = getAllProviders().length;
const totalStates = getAllStates().length;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": "https://www.mylifecareplanning.com/about/#page",
      "headline": "About the Physician Life Care Planning Directory",
      "description": "Learn about the Physician Life Care Planning Directory — who we are, how providers are listed, our editorial standards, and how to use this resource.",
      "url": "https://www.mylifecareplanning.com/about/",
      "datePublished": "2024-01-01",
      "dateModified": "2026-08-18",
      "publisher": { "@id": "https://www.mylifecareplanning.com/#organization" },
      "author": {
        "@type": "Organization",
        "name": "Physician Life Care Planning Directory",
        "url": "https://www.mylifecareplanning.com/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.mylifecareplanning.com/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://www.mylifecareplanning.com/about/" }
      ]
    }
  ]
});
---

<BaseLayout
  title="About | Physician Life Care Planning Directory"
  description="Learn about the Physician Life Care Planning Directory — our mission, how providers are listed, our editorial standards, and how legal and insurance professionals can use this resource."
  canonical="https://www.mylifecareplanning.com/about/"
  schema={schema}
>
  <Header />
  <main class="flex-1">

    <!-- Hero -->
    <section class="bg-brand-900 text-white">
      <div class="page-container py-12">
        <p class="text-xs text-brand-300 font-medium uppercase tracking-widest mb-2">About This Directory</p>
        <h1 class="text-3xl sm:text-4xl font-bold">About the Physician Life Care Planning Directory</h1>
        <p class="mt-3 text-brand-200 max-w-2xl">
          A specialized resource connecting legal, insurance, and medical teams with board-certified Physician Life Care Planners across the United States and Canada.
        </p>
      </div>
    </section>

    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto">

        <!-- Stats bar -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-10">
          <div class="bg-brand-50 border border-brand-100 rounded-xl p-5 text-center">
            <div class="text-3xl font-bold text-brand-900">{totalProviders}</div>
            <div class="text-sm text-gray-600 mt-1">Listed Planners</div>
          </div>
          <div class="bg-brand-50 border border-brand-100 rounded-xl p-5 text-center">
            <div class="text-3xl font-bold text-brand-900">{totalStates}</div>
            <div class="text-sm text-gray-600 mt-1">States & Provinces</div>
          </div>
          <div class="col-span-2 sm:col-span-1 bg-brand-50 border border-brand-100 rounded-xl p-5 text-center">
            <div class="text-3xl font-bold text-brand-900">Free</div>
            <div class="text-sm text-gray-600 mt-1">Directory Access</div>
          </div>
        </div>

        <p class="text-xs text-gray-500 mb-8">Updated: August 2026</p>

        <!-- Mission -->
        <div class="prose prose-gray max-w-none">

          <div class="not-prose mb-8 p-5 bg-brand-50 border border-brand-200 rounded-xl text-sm text-gray-700 leading-relaxed">
            <strong class="text-brand-900">Our Mission:</strong> To provide legal professionals, insurance adjusters, and families with a reliable, freely accessible reference for locating board-certified Physician Life Care Planners — qualified MDs and DOs whose expert opinions carry the weight needed in litigation and settlement proceedings.
          </div>

          <h2 class="!text-2xl !font-bold !text-brand-900 !mt-8 !mb-4">What This Directory Is</h2>
          <p>
            The Physician Life Care Planning Directory is a public information resource listing qualified Life Care Planners (LCPs) organized by state and city across the United States and Canada. It is designed to serve attorneys, insurance professionals, healthcare providers, and families who need to identify and contact a credentialed LCP expert in a specific region.
          </p>
          <p>
            This directory does not charge users to search or view listings. It is an advertising and informational service — not a referral service, law firm, or healthcare provider.
          </p>

          <h2 class="!text-2xl !font-bold !text-brand-900 !mt-8 !mb-4">Who We List</h2>
          <p>
            Listings in this directory are limited to professionals engaged in Life Care Planning services, with a primary focus on:
          </p>
          <ul>
            <li><strong>Physician Life Care Planners</strong> - Licensed MDs and DOs, typically board-certified in Physical Medicine and Rehabilitation (PM&amp;R), neurology, orthopedics, or related specialties, who have completed formal life care planning training.</li>
            <li><strong>Certified Life Care Planners (CLCP®)</strong> - Professionals holding the CLCP® credential issued by the <a href="https://www.ichcc.org" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:text-brand-900 underline">International Commission on Health Care Certification (ICHCC)</a>.</li>
            <li><strong>Medicare Set-Aside Certified Consultants (MSCC™)</strong> - Specialists trained in Medicare Set-Aside cost projections and future medical need allocations.</li>
          </ul>

          <h2 class="!text-2xl !font-bold !text-brand-900 !mt-8 !mb-4">How Providers Are Listed</h2>
          <p>
            Provider records in this directory are compiled from publicly available professional data including state licensing boards, certification body registries, and publicly disclosed professional information. Listings reflect information available at the time of data compilation.
          </p>

          <!-- Verification box -->
          <div class="not-prose my-6 p-5 border border-yellow-200 bg-yellow-50 rounded-xl text-sm text-gray-700">
            <p class="font-semibold text-gray-900 mb-1">Important: Verify Credentials Independently</p>
            <p>
              Inclusion in this directory does not constitute an endorsement, recommendation, or verification of any individual provider. Users are strongly encouraged to independently verify all credentials, licensing status, and disciplinary history directly with the relevant state medical board and certification authority before retaining any professional.
            </p>
          </div>

          <p>
            Providers may claim their listing through the contact form to update their information, add contact details, or request removal. The directory does not charge providers for basic listing inclusion.
          </p>

          <h2 class="!text-2xl !font-bold !text-brand-900 !mt-8 !mb-4">Editorial Standards</h2>
          <p>
            All informational content published on this site — including articles on Life Care Planning methodology, physician qualifications, and legal standards — is written to reflect publicly documented professional and legal frameworks. Content references established sources including:
          </p>
          <ul>
            <li><a href="https://www.law.cornell.edu/rules/fre/rule_702" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:text-brand-900 underline">Federal Rules of Evidence (FRE 702 — Expert Testimony)</a></li>
            <li><a href="https://www.ichcc.org" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:text-brand-900 underline">International Commission on Health Care Certification (ICHCC)</a> standards</li>
            <li>Published life care planning standards of practice</li>
            <li>State Corporate Practice of Medicine (CPOM) regulations</li>
          </ul>
          <p>
            Informational articles are reviewed periodically and dated with their most recent modification. Content is intended for general informational purposes only and does not constitute legal, medical, or professional advice.
          </p>

          <h2 class="!text-2xl !font-bold !text-brand-900 !mt-8 !mb-4">How to Use This Directory</h2>
          <p>
            To find a Physician Life Care Planner in your area:
          </p>
          <ol>
            <li>Navigate to <a href="/physician-life-care-planners" class="text-brand-700 hover:text-brand-900 font-medium">Browse by State</a> and select your state or province.</li>
            <li>Select a city or metropolitan area within that state.</li>
            <li>View individual provider profiles for credentials, specialty, and listing information.</li>
            <li>Use the contact details on each profile — or the "Claim Listing" option — to initiate direct outreach.</li>
          </ol>

          <h2 class="!text-2xl !font-bold !text-brand-900 !mt-8 !mb-4">Advertising & Sponsored Listings</h2>
          <p>
            This directory may include sponsored or featured placements. Sponsored providers may appear more prominently within state or city listings. Sponsored placement does not indicate endorsement, superior credentials, or a recommendation over non-sponsored listings. All providers, whether sponsored or not, are subject to the same listing standards described above.
          </p>
          <p>
            For advertising inquiries, please visit our <a href="/advertising-disclosure" class="text-brand-700 hover:text-brand-900 font-medium">Advertising Disclosure</a> page or <a href="/contact" class="text-brand-700 hover:text-brand-900 font-medium">contact us</a> directly.
          </p>

        </div>

        <!-- CTA box -->
        <div class="mt-12 p-6 bg-brand-50 border border-brand-200 rounded-xl text-center">
          <h3 class="text-lg font-semibold text-brand-900 mb-2">Have a Question or Want to List Your Practice?</h3>
          <p class="text-gray-700 mb-5 text-sm">Reach out through our contact form for provider inquiries, data corrections, advertising, or general questions.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/contact" class="btn-primary text-sm">Contact Us</a>
            <a href="/physician-life-care-planners" class="btn-primary !bg-white !text-brand-700 !border !border-brand-300 hover:!bg-brand-50 text-sm">Browse the Directory</a>
          </div>
        </div>

      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
