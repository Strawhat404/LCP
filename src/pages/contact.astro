---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";

const phone = "800-292-1919";
---

<BaseLayout
  title="Contact Us - Life Care Planner Directory"
  description="Contact the Life Care Planner Directory. Get in touch for questions about finding a Life Care Planner in your area."
>
  <Header />

  <main class="flex-1">
    <section class="bg-brand-900 text-white">
      <div class="page-container py-12 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold">Contact Us</h1>
        <p class="mt-3 text-brand-200">Get in touch with us. We're here to help.</p>
      </div>
    </section>

    <div class="page-container section-padding">
      <div class="max-w-2xl mx-auto">
        <ContactForm />
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
