---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout
  title="Contact Us - Life Care Planner Directory"
  description="Contact the Life Care Planner Directory. Get in touch for questions about finding a Life Care Planner in your area."
>
  <Header />

  <main class="flex-1">
    <section class="relative bg-brand-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="https://images.unsplash.com/photo-1423666639041-f56000c27a9a?w=1600&q=80&auto=format&fit=crop"
          alt="Person reaching out for professional support"
          class="w-full h-full object-cover opacity-20"
        />
      </div>
      <div class="relative page-container py-12 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold">Contact Us</h1>
        <p class="mt-3 text-brand-200">Get in touch with us. We're here to help.</p>
      </div>
    </section>

    <div class="page-container section-padding">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-10 items-start">

          <!-- Left: image + info -->
          <div class="md:col-span-2">
            <img
              src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=800&q=80&auto=format&fit=crop"
              alt="Professional team ready to assist"
              class="w-full aspect-video object-cover rounded-xl shadow-sm mb-6"
            />
            <h2 class="text-xl font-bold text-gray-900 mb-3">We're Here to Help</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Whether you're looking for a Life Care Planner in your state, have a question about the directory,
              or want to learn more about listing your practice — send us a message and we'll get back to you promptly.
            </p>
            <div class="space-y-3 text-sm text-gray-700">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-brand-100 rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <span>info@mylifecareplanning.com</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-brand-100 rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <span>Serving the United States and Canada</span>
              </div>
            </div>
          </div>

          <!-- Right: form -->
          <div class="md:col-span-3">
            <ContactForm />
          </div>

        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
