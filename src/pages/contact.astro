---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout
  title="Contact Us - Life Care Planner Directory"
  description="Contact the Life Care Planner Directory. Get in touch for questions about finding a Life Care Planner in your area."
>
  <Header />

  <main class="flex-1">
    <section class="relative bg-brand-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="https://images.unsplash.com/photo-1423666639041-f56000c27a9a?w=1600&q=80&auto=format&fit=crop"
          alt="Person reaching out for professional support"
          class="w-full h-full object-cover opacity-20"
        />
      </div>
      <div class="relative page-container py-12 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold">Contact Us</h1>
        <p class="mt-3 text-brand-200">Get in touch with us. We're here to help.</p>
      </div>
    </section>

    <div class="page-container section-padding">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-10 items-start">

          <!-- Left: info panel -->
          <div class="md:col-span-2 space-y-6">
            <img
              src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=800&q=80&auto=format&fit=crop"
              alt="Professional team ready to assist"
              class="w-full aspect-video object-cover rounded-xl shadow-sm"
            />

            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-2">Get in Touch</h2>
              <p class="text-gray-500 text-sm leading-relaxed">
                Whether you're looking for a Life Care Planner, have a directory question, or want to list your practice — we'll get back to you within 1 business day.
              </p>
            </div>

            <div class="space-y-4">
              <div class="flex items-center gap-4 p-4 bg-brand-50 border border-brand-100 rounded-xl">
                <div class="w-10 h-10 bg-brand-700 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Email</p>
                  <a href="mailto:info@mylifecareplanning.com" class="text-sm font-semibold text-brand-800 hover:underline">info@mylifecareplanning.com</a>
                </div>
              </div>

              <div class="flex items-center gap-4 p-4 bg-gray-50 border border-gray-100 rounded-xl">
                <div class="w-10 h-10 bg-gray-700 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Response Time</p>
                  <p class="text-sm font-semibold text-gray-800">Within 1 business day</p>
                </div>
              </div>

              <div class="flex items-center gap-4 p-4 bg-gray-50 border border-gray-100 rounded-xl">
                <div class="w-10 h-10 bg-gray-700 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Coverage</p>
                  <p class="text-sm font-semibold text-gray-800">USA &amp; Canada</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: form -->
          <div class="md:col-span-3 bg-white border border-gray-200 rounded-2xl shadow-sm p-7 sm:p-8">
            <!-- Claim listing banner — shown via JS if ?claim param is present -->
            <div id="claim-banner" class="hidden mb-5 p-4 bg-brand-50 border border-brand-200 rounded-xl flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-700 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <div>
                <p class="text-sm font-semibold text-brand-900">Claiming a listing</p>
                <p class="text-sm text-brand-700 mt-0.5">You are claiming the listing for <strong id="claim-name"></strong>. Fill in your details below and we'll verify your identity and update your profile.</p>
              </div>
            </div>
            <ContactForm />
          </div>

        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const claimSlug = params.get('claim');
  const claimName = params.get('name');

  if (claimSlug && claimName) {
    // Show the banner
    const banner = document.getElementById('claim-banner');
    const nameEl = document.getElementById('claim-name');
    if (banner && nameEl) {
      nameEl.textContent = claimName;
      banner.classList.remove('hidden');
    }

    // Inject hidden fields into the contact form
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (form) {
      const typeField = document.createElement('input');
      typeField.type = 'hidden';
      typeField.name = 'inquiry_type';
      typeField.value = 'Listing Claim Request';
      form.appendChild(typeField);

      const slugField = document.createElement('input');
      slugField.type = 'hidden';
      slugField.name = 'listing_slug';
      slugField.value = claimSlug;
      form.appendChild(slugField);

      const nameField = document.createElement('input');
      nameField.type = 'hidden';
      nameField.name = 'listing_name';
      nameField.value = claimName;
      form.appendChild(nameField);

      // Update the email subject to flag it as a claim
      const subjectField = form.querySelector('input[name="subject"]') as HTMLInputElement;
      if (subjectField) {
        subjectField.value = `Listing Claim Request — ${claimName}`;
      }
    }
  }
</script>
