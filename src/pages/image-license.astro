---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Image Licensing - MyLifeCarePlanning.com"
  description="Image licensing information for MyLifeCarePlanning.com website images and photography."
  canonical="https://www.mylifecareplanning.com/image-license/"
>
  <Header />

  <main class="flex-1">
    <section class="bg-brand-900 text-white">
      <div class="page-container py-10">
        <h1 class="text-3xl font-bold">Image Licensing</h1>
      </div>
    </section>

    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto">
        <div class="space-y-8 text-gray-700 leading-relaxed">

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Overview</h2>
            <p>Images displayed on MyLifeCarePlanning.com are used under the following licensing terms:</p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Stock Photography</h2>
            <p class="mb-4">
              Professional stock photographs used throughout this website are licensed from Unsplash under the 
              <a href="https://unsplash.com/license" target="_blank" rel="noopener" class="text-brand-700 hover:underline">Unsplash License</a>.
            </p>
            <p class="mb-4">Key terms of the Unsplash License:</p>
            <ul class="list-disc list-inside space-y-2 ml-4">
              <li>Photos can be used for free</li>
              <li>Photos can be used for commercial and non-commercial purposes</li>
              <li>Attribution is not required but appreciated</li>
              <li>Photos cannot be sold or redistributed as-is</li>
              <li>Compiling photos into a product to replicate a similar or competing service is not permitted</li>
            </ul>
            <p class="mt-4 text-sm text-gray-600">
              Images have been downloaded, optimized, and self-hosted on our servers to improve page load performance.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Original Content</h2>
            <p>
              Original graphics, logos, and illustrations created specifically for MyLifeCarePlanning.com are:
            </p>
            <p class="mt-2 font-semibold">
              © 2026 MyLifeCarePlanning.com — All Rights Reserved
            </p>
            <p class="mt-4">
              These original materials may not be reproduced, distributed, or used without explicit written permission.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Provider Avatars</h2>
            <p>
              Provider avatar images are automatically generated placeholder graphics created by our system. 
              These avatars are used for directory listings and do not represent actual photographs of listed professionals.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Third-Party Logos</h2>
            <p>
              Any third-party logos, trademarks, or brand marks displayed on this site remain the property of their 
              respective owners and are used for identification or informational purposes only.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Questions</h2>
            <p>
              For questions about image licensing or to request permission to use our original content, please contact us at:
            </p>
            <p class="mt-2">
              <a href="mailto:info@mylifecareplanning.com" class="text-brand-700 hover:underline font-medium">
                info@mylifecareplanning.com
              </a>
            </p>
          </section>

        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
