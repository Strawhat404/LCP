---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Privacy Policy - Life Care Planner Directory"
  description="Privacy Policy for the Life Care Planner Directory."
>
  <Header />

  <main class="flex-1">
    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">Privacy Policy</h1>
        <div class="prose prose-gray max-w-none text-sm space-y-4">
          <p>This Privacy Policy describes how we collect, use, and protect your information.</p>
          <h2 class="text-lg font-semibold mt-6">Information We Collect</h2>
          <p>We collect information you provide when contacting us through our contact form, including your name, email, phone number, and message content.</p>
          <h2 class="text-lg font-semibold mt-6">How We Use Your Information</h2>
          <p>We use your information to respond to inquiries and provide information about Life Care Planners.</p>
          <h2 class="text-lg font-semibold mt-6">Contact</h2>
          <p>For questions about this privacy policy, please contact us through our contact page.</p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
