---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="Advertising Disclosure — MyLifeCarePlanning.com" description="Advertising disclosure for MyLifeCarePlanning.com directory listings.">
  <Header />
  <main class="flex-1">
    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto prose prose-gray">
        <h1>Advertising Disclosure</h1>
        <p class="text-gray-500 text-sm">Last updated: August 2026</p>
        <p>MyLifeCarePlanning.com is an advertising and information service. We receive compensation from professionals and organizations that purchase enhanced or sponsored listings in our directory.</p>
        <h2>Sponsored Listings</h2>
        <p>Some listings on this site are paid placements. These are identified with a "Sponsored" label. Paid placement does not constitute an endorsement, recommendation, or warranty of any kind regarding the listed professional's services, qualifications, or fitness for any purpose.</p>
        <h2>Free Listings</h2>
        <p>Basic directory listings may be available at no charge. The presence of any listing — paid or free — does not constitute an endorsement.</p>
        <h2>Editorial Independence</h2>
        <p>Advertising relationships do not influence our editorial content, including informational articles and guides published on this site.</p>
        <h2>Contact</h2>
        <p>For questions about advertising or to update a listing, contact info@mylifecareplanning.com.</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
